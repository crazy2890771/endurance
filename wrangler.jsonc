// Cloudflare Workers config: serve the built PWA from dist/ as static assets, plus a small API.
// Used by Workers Builds (Git-connected Worker) and `npx wrangler deploy`.
{
  "name": "endurance",
  // Strava API under /api/strava (needs STRAVA_CLIENT_ID and STRAVA_CLIENT_SECRET secrets); everything else is static.
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": true,
  "build": {
    "command": "npm run build"
  },
  // One Durable Object per phone keeps its push subscription and the daily reminder alarm (push.ts).
  "durable_objects": {
    "bindings": [
      { "name": "REMINDERS", "class_name": "PushReminder" },
      // One per private calendar link: the latest duties and workouts for the iPhone Calendar (calendar.ts).
      { "name": "CALENDARS", "class_name": "CalendarFeed" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PushReminder"] },
    { "tag": "v2", "new_sqlite_classes": ["CalendarFeed"] }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    // Deep links such as /planner return index.html; the app router takes it from there.
    "not_found_handling": "single-page-application"
  }
}
